{
  "id": "CYPRESS-RWA-BANK-ACCOUNTS-003-TC001",
  "requirementId": "CYPRESS-RWA-BANK-ACCOUNTS-003",
  "title": "Create a new bank account with valid data",
  "kind": "positive",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Create bank account",
      "method": "POST",
      "pathTemplate": "/bankAccounts",
      "body": {
        "bankName": "Rich Oracle Test Bank",
        "accountNumber": "123456789",
        "routingNumber": "987654321"
      },
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "account.id",
            "op": "isType",
            "value": "string"
          },
          {
            "path": "account.userId",
            "op": "eq",
            "value": "{{user_id}}"
          },
          {
            "path": "account.bankName",
            "op": "eq",
            "value": "Rich Oracle Test Bank"
          },
          {
            "path": "account.accountNumber",
            "op": "eq",
            "value": "123456789"
          },
          {
            "path": "account.routingNumber",
            "op": "eq",
            "value": "987654321"
          },
          {
            "path": "account.isDeleted",
            "op": "eq",
            "value": false
          },
          {
            "path": "account.createdAt",
            "op": "eq",
            "value": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          {
            "path": "account.modifiedAt",
            "op": "eq",
            "value": "^\\d{4}-\\d{2}-\\d{2}T"
          }
        ]
      }
    }
  ]
}