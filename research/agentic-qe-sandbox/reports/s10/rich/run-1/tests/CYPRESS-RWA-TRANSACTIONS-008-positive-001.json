{
  "id": "CYPRESS-RWA-TRANSACTIONS-008-positive-001",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-008",
  "title": "Create a new request transaction successfully",
  "kind": "positive",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get authenticated user details before transaction",
      "method": "GET",
      "pathTemplate": "/users/{{user_id}}",
      "expect": {
        "status": 200
      },
      "capture": {
        "sender_balance_before": "user.balance"
      }
    },
    {
      "name": "Create request transaction",
      "method": "POST",
      "pathTemplate": "/transactions",
      "body": {
        "transactionType": "request",
        "source": "",
        "receiverId": "{{other_user_id}}",
        "description": "Rich oracle request test",
        "amount": 2500,
        "privacyLevel": "public"
      },
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "transaction.id",
            "op": "isType",
            "value": "string"
          },
          {
            "path": "transaction.senderId",
            "op": "eq",
            "value": "{{user_id}}"
          },
          {
            "path": "transaction.receiverId",
            "op": "eq",
            "value": "{{other_user_id}}"
          },
          {
            "path": "transaction.description",
            "op": "eq",
            "value": "Rich oracle request test"
          },
          {
            "path": "transaction.amount",
            "op": "eq",
            "value": 2500
          },
          {
            "path": "transaction.status",
            "op": "eq",
            "value": "pending"
          },
          {
            "path": "transaction.requestStatus",
            "op": "eq",
            "value": "pending"
          },
          {
            "path": "transaction.createdAt",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "Verify sender balance unchanged after request",
      "method": "GET",
      "pathTemplate": "/users/{{user_id}}",
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "user.balance",
            "op": "eq",
            "value": "{{sender_balance_before}}"
          }
        ]
      }
    }
  ]
}