{
  "id": "CYPRESS-RWA-CONTACTS-003-TC4",
  "requirementId": "CYPRESS-RWA-CONTACTS-003",
  "title": "POST /contacts unauthenticated with malformed contactUserId returns 401",
  "kind": "auth",
  "actor": "anonymous",
  "requests": [
    {
      "name": "Create contact without authentication",
      "method": "POST",
      "pathTemplate": "/contacts",
      "body": {
        "contactUserId": "1234"
      },
      "expect": {
        "status": 401,
        "jsonPath": [
          {
            "path": "error",
            "op": "eq",
            "value": "Unauthorized"
          }
        ]
      }
    }
  ]
}