{
  "id": "CYPRESS-RWA-BANK-ACCOUNTS-003-TC003",
  "requirementId": "CYPRESS-RWA-BANK-ACCOUNTS-003",
  "title": "Create bank account without authentication returns 401",
  "kind": "auth",
  "actor": "anonymous",
  "requests": [
    {
      "name": "Create bank account unauthenticated",
      "method": "POST",
      "pathTemplate": "/bankAccounts",
      "body": {
        "bankName": "No Auth Bank",
        "accountNumber": "123456789",
        "routingNumber": "987654321"
      },
      "expect": {
        "status": 401,
        "jsonPath": [
          {
            "path": "error",
            "op": "eq",
            "value": "Unauthorized"
          }
        ]
      }
    }
  ]
}