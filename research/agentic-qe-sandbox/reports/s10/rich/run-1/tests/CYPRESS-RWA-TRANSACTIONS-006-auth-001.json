{
  "id": "CYPRESS-RWA-TRANSACTIONS-006-auth-001",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-006",
  "title": "Get public transactions - unauthenticated request returns 401",
  "kind": "auth",
  "actor": "anonymous",
  "requests": [
    {
      "name": "Get public transactions without authentication",
      "method": "GET",
      "pathTemplate": "/transactions/public",
      "expect": {
        "status": 401,
        "jsonPath": [
          {
            "path": "$.error",
            "op": "eq",
            "value": "Unauthorized"
          }
        ]
      }
    }
  ]
}