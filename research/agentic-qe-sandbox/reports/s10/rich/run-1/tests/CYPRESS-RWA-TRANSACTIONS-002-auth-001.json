{
  "id": "CYPRESS-RWA-TRANSACTIONS-002-auth-001",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-002",
  "title": "Get pending transactions without authentication returns 401",
  "kind": "auth",
  "actor": "anonymous",
  "requests": [
    {
      "name": "Get pending transactions unauthenticated",
      "method": "GET",
      "pathTemplate": "/transactions",
      "query": {
        "requestStatus": "pending"
      },
      "expect": {
        "status": 401,
        "jsonPath": [
          {
            "path": "$.error",
            "op": "eq",
            "value": "Unauthorized"
          }
        ]
      }
    }
  ]
}