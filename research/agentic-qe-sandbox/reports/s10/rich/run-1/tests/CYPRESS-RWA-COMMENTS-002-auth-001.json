{
  "id": "CYPRESS-RWA-COMMENTS-002-auth-001",
  "requirementId": "CYPRESS-RWA-COMMENTS-002",
  "title": "Post comment without authentication returns 401",
  "kind": "auth",
  "actor": "anonymous",
  "requests": [
    {
      "name": "Post comment unauthenticated",
      "method": "POST",
      "pathTemplate": "/comments/1",
      "pathParams": {
        "transaction_id": "1"
      },
      "body": {
        "content": "No auth comment"
      },
      "expect": {
        "status": 401,
        "jsonPath": [
          {
            "path": "$.error",
            "op": "eq",
            "value": "Unauthorized"
          }
        ]
      }
    }
  ]
}