{
  "id": "CYPRESS-RWA-TRANSACTIONS-003-TC1",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-003",
  "title": "Get pending request transactions for user within a time range - authenticated",
  "kind": "positive",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get pending transactions in date range",
      "method": "GET",
      "pathTemplate": "/transactions",
      "query": {
        "requestStatus": "pending",
        "rangeStartTs": "2018-01-01T00:00:00.000Z",
        "rangeEndTs": "2030-12-05T00:00:00.000Z"
      },
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "$.results",
            "op": "isType",
            "value": "array"
          },
          {
            "path": "$.pageData.page",
            "op": "exists"
          },
          {
            "path": "$.pageData.limit",
            "op": "exists"
          },
          {
            "path": "$.results[0].senderId",
            "op": "exists"
          },
          {
            "path": "$.results[0].receiverId",
            "op": "exists"
          },
          {
            "path": "$.results[0].createdAt",
            "op": "exists"
          },
          {
            "path": "$.results[?(@.requestStatus!='pending')]",
            "op": "isType",
            "value": "array"
          },
          {
            "path": "$.results[?(@.senderId!='{{user_id}}' && @.receiverId!='{{user_id}}')]",
            "op": "isType",
            "value": "array"
          }
        ]
      }
    }
  ]
}