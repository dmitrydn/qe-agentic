{
  "id": "CYPRESS-RWA-TRANSACTIONS-001-TC01",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-001",
  "title": "Get personal transactions list - authenticated user sees only their transactions",
  "kind": "positive",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get transactions for authenticated user",
      "method": "GET",
      "pathTemplate": "/transactions",
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "results",
            "op": "isType",
            "value": "array"
          },
          {
            "path": "results.length",
            "op": "gte",
            "value": 1
          },
          {
            "path": "pageData.page",
            "op": "exists"
          },
          {
            "path": "pageData.limit",
            "op": "exists"
          },
          {
            "path": "pageData.totalPages",
            "op": "exists"
          },
          {
            "path": "pageData.hasNextPages",
            "op": "isType",
            "value": "boolean"
          },
          {
            "path": "results[0].id",
            "op": "isType",
            "value": "string"
          },
          {
            "path": "results[0].amount",
            "op": "exists"
          },
          {
            "path": "results[0].senderId",
            "op": "exists"
          },
          {
            "path": "results[0].receiverId",
            "op": "exists"
          },
          {
            "path": "results[0].status",
            "op": "exists"
          },
          {
            "path": "results[0].createdAt",
            "op": "isType",
            "value": "string"
          }
        ]
      }
    }
  ]
}