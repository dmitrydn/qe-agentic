{
  "id": "CYPRESS-RWA-TRANSACTIONS-010-TC3",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-010",
  "title": "PATCH transaction with unknown field returns 422",
  "kind": "negative",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get transactions to capture id",
      "method": "GET",
      "pathTemplate": "/transactions",
      "capture": {
        "transaction_id": "results[0].id"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "PATCH transaction with unknown field",
      "method": "PATCH",
      "pathTemplate": "/transactions/{id}",
      "pathParams": {
        "id": "{{transaction_id}}"
      },
      "body": {
        "notATransactionField": "not a transaction field"
      },
      "expect": {
        "status": 422,
        "jsonPath": [
          {
            "path": "errors",
            "op": "exists"
          },
          {
            "path": "errors[0].param",
            "op": "eq",
            "value": "requestStatus"
          }
        ]
      }
    }
  ]
}