{
  "id": "CYPRESS-RWA-TRANSACTIONS-006-positive-001",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-006",
  "title": "Get public transactions - authenticated user receives valid response",
  "kind": "positive",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get public transactions",
      "method": "GET",
      "pathTemplate": "/transactions/public",
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "$.results",
            "op": "isType",
            "value": "array"
          },
          {
            "path": "$.results.length",
            "op": "gte",
            "value": 1
          },
          {
            "path": "$.pageData.page",
            "op": "exists"
          },
          {
            "path": "$.pageData.limit",
            "op": "exists"
          },
          {
            "path": "$.pageData.totalPages",
            "op": "exists"
          },
          {
            "path": "$.results[0].id",
            "op": "isType",
            "value": "string"
          },
          {
            "path": "$.results[0].privacyLevel",
            "op": "exists"
          },
          {
            "path": "$.results[0].senderId",
            "op": "exists"
          },
          {
            "path": "$.results[0].receiverId",
            "op": "exists"
          },
          {
            "path": "$.results[0].createdAt",
            "op": "eq",
            "value": "^\\d{4}-\\d{2}-\\d{2}T"
          }
        ]
      }
    }
  ]
}