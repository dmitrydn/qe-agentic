{
  "id": "CYPRESS-RWA-USERS-003-TC1",
  "requirementId": "CYPRESS-RWA-USERS-003",
  "title": "GET /users/1234 returns 422 with validation error for malformed userId",
  "kind": "negative",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get user with numeric malformed userId",
      "method": "GET",
      "pathTemplate": "/users/1234",
      "expect": {
        "status": 422,
        "jsonPath": [
          {
            "path": "errors",
            "op": "isType",
            "value": "array"
          },
          {
            "path": "errors.length",
            "op": "eq",
            "value": 1
          },
          {
            "path": "errors[0].param",
            "op": "eq",
            "value": "userId"
          },
          {
            "path": "errors[0].msg",
            "op": "exists"
          }
        ]
      }
    }
  ]
}