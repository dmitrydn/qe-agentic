  "title": "POST /users with invalid defaultPrivacyLevel returns 422",
  "kind": "negative",
  "actor": "anonymous",
  "requests": [
    {
      "name": "Create user with invalid privacy level",
      "method": "POST",
      "pathTemplate": "/users",
      "body": {
        "firstName": "Rich",
        "lastName": "Oracle",
        "username": "rich_oracle_user",
        "password": "password123",
        "defaultPrivacyLevel": "not-a-real-privacy-level"
      },
      "expect": {
        "status": 422,
        "jsonPath": [
          {
            "path": "errors",
