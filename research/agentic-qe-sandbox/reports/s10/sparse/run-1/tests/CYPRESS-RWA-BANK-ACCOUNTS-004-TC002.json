{
  "id": "CYPRESS-RWA-BANK-ACCOUNTS-004-TC002",
  "requirementId": "CYPRESS-RWA-BANK-ACCOUNTS-004",
  "title": "Delete a bank account - unauthorized user cannot delete another user's account",
  "kind": "auth",
  "actor": "primaryUser",
  "requests": [
    {
