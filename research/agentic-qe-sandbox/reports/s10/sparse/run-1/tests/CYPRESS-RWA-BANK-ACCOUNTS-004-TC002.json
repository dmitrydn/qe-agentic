      "method": "DELETE",
      "pathTemplate": "/bankAccounts/{{other_user_bank_account_id}}",
      "pathParams": {
        "other_user_bank_account_id": "{{other_user_bank_account_id}}"
      },
      "expect": {
        "statusIn": [
          401,
          403,
          404
        ]
      }
    }
  ]
}