{
  "id": "CYPRESS-RWA-TRANSACTIONS-010-TC1",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-010",
  "title": "PATCH transaction with invalid requestStatus enum value returns 422",
  "kind": "negative",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get transactions to capture a transaction id",
      "method": "GET",
      "pathTemplate": "/transactions",
      "expect": {
        "status": 200,
        "jsonPath": [
          {
            "path": "results[0].id",
            "op": "exists"
          }
        ]
      },
      "capture": {
        "transaction_id": "results[0].id"
      }
    },
    {
      "name": "PATCH transaction with invalid requestStatus",
      "method": "PATCH",
      "pathTemplate": "/transactions/{{transaction_id}}",
      "pathParams": {
        "transaction_id": "{{transaction_id}}"
      },
      "body": {
        "requestStatus": "not-a-real-status"
      },
      "expect": {
        "status": 422
      }
    }
  ]
}