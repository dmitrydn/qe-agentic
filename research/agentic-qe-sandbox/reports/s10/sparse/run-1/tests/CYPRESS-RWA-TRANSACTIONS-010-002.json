{
  "id": "CYPRESS-RWA-TRANSACTIONS-010-002",
  "requirementId": "CYPRESS-RWA-TRANSACTIONS-010",
  "title": "PATCH /transactions with invalid requestStatus returns 422",
  "kind": "negative",
  "actor": "primaryUser",
  "requests": [
    {
      "name": "Get transactions to capture transaction_id",
      "method": "GET",
      "pathTemplate": "/transactions",
      "capture": {
        "transaction_id": "results[0].id"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "Update transaction with invalid requestStatus",
      "method": "PATCH",
      "pathTemplate": "/transactions/{{transaction_id}}",
      "pathParams": {
        "transaction_id": "{{transaction_id}}"
      },
      "body": {
        "requestStatus": "not-a-real-status"
      },
      "expect": {
        "status": 422
      }
    }
  ]
}